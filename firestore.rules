rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId);
      allow update: if isSignedIn() && (isOwner(userId) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatarUrl']));
      allow delete: if false;
    }

    // Student Profiles
    match /studentProfiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId);
      allow delete: if false;
    }

    // Quiz Attempts
    match /quizAttempts/{attemptId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(attemptId);
      allow update, delete: if false;
    }

    // Worksheet Submissions
    match /worksheetSubmissions/{submissionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(submissionId);
      allow delete: if false;
    }

    // Teacher Feedbacks
    match /teacherFeedbacks/{feedbackId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(feedbackId);
      allow delete: if false;
    }

    // Videos Collection (Educational video list and order)
    match /videos/{videoId} {
      allow read: if true;
      allow write: if true;
    }

    // Stage Locks & Classrooms (Lock status for learning map)
    match /stageLocks/{lockId} {
      allow read: if true;
      allow write: if true;
    }

    match /classrooms/{classId} {
      allow read: if true;
      allow write: if true;
    }

    // Quizzes and Lessons
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if true;
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
